# --- Core ---
DATABASE_URL=postgresql+psycopg://ideaform:ideaform@db:5432/ideaform
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_MINUTES=60
LOG_LEVEL=INFO

# --- Local inference (no provider keys) ---
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL_FAST=qwen2.5:3b-instruct
LLM_MODEL_STRONG=qwen2.5:7b-instruct
LLM_CONTEXT_WINDOW=8192
LLM_REQUEST_TIMEOUT=180
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Live discovery (the only paid API) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
TAVILY_RESULTS_PER_RUN=40
TAVILY_SEARCH_DEPTH=basic
TAVILY_CACHE_TTL_HOURS=168

# --- Self-hosted scraper ---
SCRAPER_USER_AGENT="IdeaformBot/1.0 (+mailto:you@example.com)"
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_MAX_PAGES_PER_RUN=40
SCRAPER_MAX_BYTES_PER_PAGE=2000000
SCRAPER_PLAYWRIGHT_ENABLED=true
SCRAPER_TIMEOUT_SECONDS=20

# --- Limits ---
DAILY_TOKEN_LIMIT_PER_USER=200000
