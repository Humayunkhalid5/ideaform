# --- Core ---
# development | test | production
ENVIRONMENT=development
# Docker Compose overrides this. For a local (non-Docker) PostgreSQL use e.g.
# postgresql+psycopg://postgres:<password>@localhost:5432/ideaform
DATABASE_URL=postgresql+psycopg://ideaform:ideaform@db:5432/ideaform
REDIS_URL=redis://redis:6379/0
# Required: the API refuses to start with a placeholder or a secret under 32 chars.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_MINUTES=60
LOG_LEVEL=INFO
# true runs extraction jobs inside the API request (no Redis/Celery worker needed)
JOBS_INLINE=false

# --- LLM provider ---
# hosted LLM provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b
LLM_CONTEXT_WINDOW=8192
LLM_REQUEST_TIMEOUT=180
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Live discovery (the only paid search API) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
TAVILY_RESULTS_PER_RUN=40
TAVILY_SEARCH_DEPTH=basic
TAVILY_CACHE_TTL_HOURS=168
# hard stop on paid Tavily calls per UTC day (basic search = 1 credit); then cache/seed fallback
TAVILY_DAILY_CREDIT_CAP=200

# --- Knowledge engine (Phase 2) ---
# where Hugging Face models are cached (defaults to ~/.cache/huggingface)
HF_HOME=
RERANKER_ENABLED=true
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_SEMANTIC_K=30
RETRIEVAL_KEYWORD_K=30
RETRIEVAL_RERANK_K=20
RETRIEVAL_FINAL_K=8
MAX_UPLOAD_BYTES=10000000

# --- Self-hosted scraper ---
SCRAPER_USER_AGENT="IdeaformBot/1.0 (educational research crawler; respects robots.txt)"
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_MAX_PAGES_PER_RUN=40
SCRAPER_MAX_BYTES_PER_PAGE=2000000
SCRAPER_PLAYWRIGHT_ENABLED=true
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MIN_WORDS=120
# contact (email or URL) added to the User-Agent; Wikipedia rejects crawlers without one
SCRAPER_CONTACT=
# SEC EDGAR requires a real contact email; EDGAR seeding is skipped without it
SEC_CONTACT_EMAIL=

# --- Limits ---
DAILY_TOKEN_LIMIT_PER_USER=200000
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
